<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Голосовий ввід (R14, тікет 03): мікрофон для SpeechRecognizer, -->
    <!-- інтернет — для мережевого розпізнавання і перекладу (тікет 02). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Фонове програвання (R45, тікет 08): foreground-сервіс з медіа-сесією, -->
    <!-- живий з вимкненим екраном. FOREGROUND_SERVICE_MEDIA_PLAYBACK — обов'язковий -->
    <!-- супутник foregroundServiceType="mediaPlayback" на API 34+. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:name=".LearnEverywhereApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.LearnEverywhere"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.LearnEverywhere">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- playback/ (тікет 08) — foreground-сервіс з androidx.media3 MediaSession, -->
        <!-- запускається й зупиняється самим PlaybackController (не має свого intent-filter). -->
        <service
            android:name=".playback.PlaybackMediaService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- data/ (тікет 09) — DictionaryRepository.exportToJson пише файл у кеш і
             віддає його як content://-Uri через DictionaryExportProvider: без
             провайдера системний діалог "поділитися" падав би з
             FileUriExposedException (targetSdk 37 забороняє передавати
             file://-Uri іншим застосункам через Intent). Вийшло за межі зони
             "data/" за манифестом тікета — без цього провайдера критерій
             приймання (реальний діалог "поділитися") нездійсненний. -->
        <provider
            android:name=".data.repository.DictionaryExportProvider"
            android:authorities="${applicationId}.exportprovider"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>

</manifest>
